
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\pipeline-references\MonoGame.Extended.Content.Pipeline.dll

#---------------------------------- Content ---------------------------------#

#begin data/dataAudio/music_index.json
/copy:data/dataAudio/music_index.json;data/dataAudio/music_index

#begin data/dataAudio/sfx_index.json
/copy:data/dataAudio/sfx_index.json;data/dataAudio/sfx_index

#begin data/dataAudio/voiceMC_index.json
/copy:data/dataAudio/voiceMC_index.json;data/dataAudio/voiceMC_index

#begin data/dataEnemy/enemy_tutorial_animation.json
/copy:data/dataEnemy/enemy_tutorial_animation.json

#begin data/dataPlayer/player_animation.json
/copy:data/dataPlayer/player_animation.json;data/dataPlayer/player_animation

#begin font/fontGenshin_0.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/processorParam:Version=3.8.5.1
/build:font/fontGenshin_0.png

#begin font/fontGenshin_1.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/processorParam:Version=3.8.5.1
/build:font/fontGenshin_1.png

#begin font/fontGenshin.fnt
/importer:BitmapFontImporter
/processor:BitmapFontProcessor
/processorParam:Version=6.1.1.0
/build:font/fontGenshin.fnt

#begin level/tile/level_tutorial.tmx
/importer:TiledTilemapImporter
/processor:TilemapProcessor
/processorParam:LevelName=
/processorParam:Version=6.1.1.0
/build:level/tile/level_tutorial.tmx

#begin music/STATEplay/bgmTutorial.mp3
/importer:Mp3Importer
/processor:SongProcessor
/processorParam:Quality=Best
/processorParam:Version=3.8.5.1
/build:music/STATEplay/bgmTutorial.mp3;music/STATEplay/bgmTutorial

#begin sfx/foley/hover.mp3
